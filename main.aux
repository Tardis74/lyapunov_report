\newlabel{fig:pert_A1593}{{15}{18}{Тест на возмущение для орбиты \(A\,1593\) (\(\delta =10^{-13}\), \(K=6\)). Слева: орбиты во вращающейся системе (первые 2 периода). В центре: \(| \Delta X(t) |\). Справа: \(| \Delta X(nT) |\) и линейный фит \(\lambda _{\text {fit}} \approx 0.319\) (каталожное \(\lambda _{\text {cat}} \approx 0.324\))}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Тест на возмущение для орбиты \(A\,1641\) (\(\delta =10^{-16}\), \(K=8\)). \(\lambda _{\text  {fit}} \approx 0.381\) против \(\lambda _{\text  {cat}} \approx 0.325\).}}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:pert_A1641}{{16}{18}{Тест на возмущение для орбиты \(A\,1641\) (\(\delta =10^{-16}\), \(K=8\)). \(\lambda _{\text {fit}} \approx 0.381\) против \(\lambda _{\text {cat}} \approx 0.325\)}{figure.caption.16}{}}
